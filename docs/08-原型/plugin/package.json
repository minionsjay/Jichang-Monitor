{
  "name": "@local/airmon-sidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "机场监控侧边栏面板：KPI / 47 机场卡片 / 套餐到期 / 告警流 / 华为命中区",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./panel": "./panel.html",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "logic.js",
    "client.js",
    "panel.html",
    "data.json",
    "icon.svg",
    "cordis.patch.yml",
    "locale/"
  ],
  "engines": { "dsh": "*" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
